# Copy to .env, replace with a strong shared password (minimum 12 characters).
APP_PASSWORD=replace-this-with-a-long-unique-password
PORT=3000
# Only set if behind HTTPS / reverse proxy; HTTPS is necessary for microphone on other devices.
COOKIE_SECURE=false
# Optional production TURN relay for mobile carrier / restrictive NAT networks.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-secret
